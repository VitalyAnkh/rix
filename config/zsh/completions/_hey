#compdef hey
#
# Almost nothing here is hardcoded. `hey help --dump [CMD]` supplies the
# subcommand list and each command's flags and arguments, generated from the
# OPTIONS: and ARGUMENTS: sections of its comment header, and `hey help --scan
# DIRS` describes the scripts in a directory. Both live in lib/hey/docs.janet.
#
# What's left here is the dynamic half of hey's dispatcher, which has to walk
# $DOTFILES_HOME:
#
#   hey wm|host CMD        -- scripts in {config/$WM,hosts/$HOST}/bin
#   hey @FOO CMD           -- scripts in config/FOO/bin
#   hey .FOO               -- scripts in hosts/$HOST/bin, config/$WM/bin, or bin/
#   hey hook HOOK          -- hooks in {$XDG_CONFIG_HOME/$WM,config/$WM,hosts/$HOST}/hooks
#                             and $XDG_DATA_HOME/hey/hooks.d
#
# Script directories nest: a NAME.d (or NAME/) directory beside NAME is
# descended into, exactly like lib/hey/init.janet's resolve-1.
#
# compinit's _comp_setup already sets extendedglob, NO_globsubst and
# NO_shwordsplit for every completion, so nothing here needs its own setopt.
# It also declares `local -a reply`, which is why the results below go into
# $_hey_reply: zstyle -e assigns into the caller's $reply, so handing that name
# to _describe risks it being clobbered out from under us.

# Leave "name:description" pairs for the scripts in DIRS in $_hey_reply.
__hey_scan() {
  (( $# )) || return 1
  (( $+commands[hey] )) || return 1
  _hey_reply=( ${(f)"$(command hey help --scan "$@" 2>/dev/null)"} )
  (( $#_hey_reply ))
}

# Leave the lines of `hey help --dump ARGS` in $_hey_reply.
__hey_dump() {
  (( $+commands[hey] )) || return 1
  _hey_reply=( ${(f)"$(command hey help --dump "$@" 2>/dev/null)"} )
  (( $#_hey_reply ))
}

__hey_scripts() {
  local -a _hey_reply
  __hey_scan "$@" || return 1
  _describe -t scripts 'script' _hey_reply
}

# Walk scripts in FOO.d/BAR directories for each word. Expects $words[1] to be
# the first argument to hey's resolver. Once a leaf script is reached, its own
# arguments are completed from its comment header, the same way __hey_dispatch
# does for hey's subcommands.
__hey_scriptdir() {
  local -a dirs=( "$@" ) next _hey_reply
  local dir word
  # Rebuild the command line for `hey help --dump`: $_hey_cmd is what the
  # calling arm already consumed, $_hey_sigil the prefix it stripped from
  # $words[1] in place (the "." of ".NAME").
  local -a cmd=( $_hey_cmd )
  local sigil=$_hey_sigil

  while (( CURRENT > 1 )); do
    word=$words[1]
    [[ -z $word || $word == -* ]] && break
    next=()
    for dir in $dirs; do
      # hey resolves NAME before NAME.d; offering both is a harmless superset.
      [[ -d $dir/$word ]] && next+=( $dir/$word )
      [[ -d $dir/$word.d ]] && next+=( $dir/$word.d )
    done
    (( $#next )) || break
    dirs=( $next )
    # The sigil belongs to whichever word comes first, consumed or leaf.
    cmd+=( $sigil$word ); sigil=
    shift words
    (( CURRENT-- ))
  done

  if (( CURRENT == 1 )); then
    __hey_scripts $dirs
    return
  fi

  # $cmd stays unquoted: it is an array, one word per element.
  [[ $words[1] == -* ]] || __hey_dump $cmd "$sigil$words[1]" || { _default; return }
  _arguments -C $_hey_reply
}

# Consume $words[1] as a dispatch prefix, then complete the scripts under DIRS.
__hey_subdir() {
  local -a _hey_cmd=( $words[1] )
  shift words
  (( CURRENT-- ))
  __hey_scriptdir "$@"
}

__hey_commands() {
  local -a cmds aliases groups scripts _hey_reply
  local expl

  # Use ./path and /path verbatim
  [[ $PREFIX == (|.)/* ]] && { _files; return }

  # @FOO dispatches to config/FOO/bin
  if compset -P '@'; then
    (( $#_hey_cfgdirs )) || return 1
    _wanted directories expl 'config directory' compadd -a _hey_cfgdirs
    return
  fi

  # .FOO searches the host, wm, then top-level bin directories
  if compset -P '.'; then
    __hey_scripts $_hey_bindirs
    return
  fi

  # `hey help --dump` emits ready-made _describe pairs in three groups:
  # commands, aliases, then the sigil patterns. It always emits all three, and
  # the first holds every command, so neither can be empty in practice; the (@)
  # is still load-bearing, to keep an empty group from shifting later ones.
  (( $+commands[hey] )) || return 1
  groups=( "${(@ps:\n\n:)"$(command hey help --dump 2>/dev/null)"}" )
  (( $#groups >= 2 )) || return 1
  cmds=( ${(f)groups[1]} )
  aliases=( ${(f)groups[2]} )
  _describe -t commands 'hey command' cmds -- aliases

  # Offer dynamic namespaces too, so a bare `hey TAB` is a full menu. The sigils
  # are part of the match so they don't shadow real subcommands.
  if __hey_scan $_hey_bindirs; then
    scripts=( ${_hey_reply/#/.} )
    _describe -t scripts 'script' scripts
  fi
  local -a dirs=( ${_hey_cfgdirs/#/@} )
  (( $#dirs )) &&
    _wanted directories expl 'config directory' compadd -a dirs
}

__hey_hooks() {
  local -a dirs extra known found _hey_reply

  dirs=(
    ${_hey_wm:+${XDG_CONFIG_HOME:-$HOME/.config}/$_hey_wm/hooks}
    ${_hey_wm:+$_hey_root/config/$_hey_wm/hooks}
    $_hey_root/hosts/$_hey_host/hooks
  )
  __hey_scan $dirs
  # all runs for every hook, taking --HOOK; it is not a hook of its own
  _hey_reply=( ${_hey_reply:#all:*} )

  # Third parties (like nixos modules) can drop extra handlers in
  # $XDG_DATA_HOME/hey/hooks.d/HOOK.d/.
  found=( $_hey_datadir/hooks.d/*.d(N/:t) )
  extra=( ${found%.d} )
  known=( ${(@)_hey_reply%%:*} )
  extra=( ${extra:|known} )

  (( $#_hey_reply || $#extra )) || return 1
  _describe -t hooks 'hook' _hey_reply -- extra
}

__hey_path_segment() {
  if [[ $line[1] == xdg ]]; then
    local expl
    _wanted directories expl 'XDG directory' \
      compadd bin config data cache state runtime fake
  else
    _files
  fi
}

__hey_hosts() {
  local expl
  local -a hosts=( $_hey_root/hosts/*(N-/:t) )
  (( $#hosts )) && _wanted hosts expl 'host' compadd -a hosts
}

__hey_generations() {
  local expl
  local -a gens=( /nix/var/nix/profiles/system-*-link(N:t:s/system-//:s/-link//) )
  (( $#gens )) && _wanted generations expl 'generation' compadd -o numeric -a gens
}

__hey_inputs() {
  local expl
  local -a inputs
  (( $+commands[jq] )) && [[ -r $_hey_root/flake.lock ]] &&
    inputs=( ${(f)"$(jq -r '.nodes.root.inputs | keys[]' -- $_hey_root/flake.lock 2>/dev/null)"} )
  (( $#inputs )) && _wanted inputs expl 'flake input' compadd -a inputs
}

# The NixOS suites, named as test/nixos/_lib.nix's collectSuites names them: the
# path under test/nixos, minus the .nix, with "/" turned into "-". Read off the
# filesystem, not from `hey test -l`, which evaluates the flake twice and is far
# too slow to hang a TAB on.
__hey_test_suites() {
  local expl root=$_hey_root/test/nixos
  local -a files suites
  files=( $root/**/*.nix(N.) )
  files=( ${files#$root/} )
  # collectSuites skips _private paths, NAME.d directories, and the default.nix
  # a directory is entered through.
  files=( ${files:#(*/|)(_*|default.nix)} )
  files=( ${files:#*.d/*} )
  suites=( ${${files%.nix}//\//-} )
  (( $#suites )) && _wanted suites expl 'nixos suite' compadd -a suites
}

__hey_info_keys() {
  local -a keys
  (( $+commands[jq] )) && [[ -r $_hey_datadir/info.json ]] &&
    keys=( ${(f)"$(jq -r 'keys[]' -- $_hey_datadir/info.json 2>/dev/null)"} )
  _alternative \
    'queries:query:((ip:"print this machine'"'"'s IP address"))' \
    'keys:info key:compadd -a keys'
}

__hey_vars() {
  local expl dir
  if (( $+opt_args[-g] )); then
    dir=$_hey_datadir/vars.d
  else
    dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/hey/vars.d
  fi
  local -a vars=( $dir/*(N.:t) )
  (( $#vars )) && _wanted vars expl 'variable' compadd -a vars
}

__hey_sync_arg()    { [[ $line[1] == rollback ]] && { __hey_generations; return }; _default }
__hey_profile_arg() { [[ $line[1] == (rm|diff) ]] && { __hey_generations; return }; return 1 }

# `test nixos SUITE` takes a single suite name; `test hey ARGS` passes its
# arguments to judge, which takes test files.
__hey_test_arg() {
  case $line[1] in
    (nix|nixos) (( $#line > 2 )) || __hey_test_suites ;;
    (hey) _files ;;
    (*) return 1 ;;
  esac
}

__hey_dispatch() {
  local curcontext="${curcontext%:*:*}:hey-${words[1]}:"
  local state line
  typeset -A opt_args
  local -a _hey_reply

  case $words[1] in
    (h|help|which)
      _arguments -C \
        '1: :__hey_commands' \
        '*:: :->args' && return 0
      [[ $state == args ]] && __hey_dispatch
      ;;

    # Paths are executed verbatim. This must precede (.*), which would
    # otherwise claim ./foo and search for a script named /foo.
    (./*|/*) _default ;;

    # These dispatch into a directory of scripts instead of taking arguments of
    # their own, so there is no header of their own to read.
    (host)  __hey_subdir $_hey_root/hosts/$_hey_host/bin ;;
    (wm)    __hey_subdir $_hey_root/config/$_hey_wm/bin ;;
    (@*)    __hey_subdir $_hey_root/config/${words[1]#@}/bin ;;
    (.*)
      local _hey_sigil=.
      words[1]=${words[1]#.}
      __hey_scriptdir $_hey_bindirs
      ;;

    # Dispatch rules with no script of their own to read a header from. bin/hey
    # maps get/set to a lambda with no file, so --dump has nothing to emit.
    (exec)
      _arguments -C \
        '1:command:_command_names -e' \
        '*:: :_default'
      ;;
    (get|set)
      _arguments -C \
        '-g[read or write a persistent (global) var]' \
        '1: :__hey_vars'
      ;;

    # Everything else is generated from the subcommand's own comment header. A
    # command with no OPTIONS:/ARGUMENTS: section takes no arguments, so an
    # empty dump means there is nothing to offer, not an error.
    (*) __hey_dump "$words[1]" && _arguments -C $_hey_reply ;;
  esac
}

_hey() {
  local curcontext="$curcontext" state line
  typeset -A opt_args
  local -a globals _hey_reply

  # `hey` resolves these internally (see lib/hey/lib.janet)
  local _hey_root=${DOTFILES_HOME:-${${(%):-%x}:A:h:h:h:h}}
  local _hey_host=$HOST
  local _hey_wm=${${(M)${(L)XDG_CURRENT_DESKTOP}:#*hyprland*}:+hypr}
  local _hey_datadir=${XDG_DATA_HOME:-$HOME/.local/share}/hey
  # An unset $_hey_wm would collapse config/$_hey_wm/bin to config/bin, so it
  # has to drop out of the list entirely.
  local -a _hey_bindirs=(
    $_hey_root/hosts/$_hey_host/bin
    ${_hey_wm:+$_hey_root/config/$_hey_wm/bin}
    $_hey_root/bin
  )
  local -a _hey_cfgdirs=( $_hey_root/config/*/bin(N-/:h:t) )

  # hey's own flags come from bin/hey's header, like every other command's. By
  # absolute path, not `.hey`, which would resolve through the search path and
  # let a script named `hey` in an earlier bin/ shadow it.
  __hey_dump $_hey_root/bin/hey && globals=( $_hey_reply )

  _arguments -C -A '-*' \
    $globals \
    '1: :__hey_commands' \
    '*:: :->args' && return 0

  [[ $state == args ]] || return 1
  __hey_dispatch
}

_hey "$@"
